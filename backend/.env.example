# Application
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Security
JWT_SECRET=super_secret_string_for_access_tokens_replace_in_production_with_64_chars
JWT_REFRESH_SECRET=another_super_secret_for_refresh_tokens_replace_in_production
# 32-byte (64 hex characters) key for AES-256-GCM encryption of PII:
ENCRYPTION_KEY_PII=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Configuration
PGHOST=localhost
PGPORT=5432
PGDATABASE=auracare_dev
PGUSER=postgres
PGPASSWORD=your_pgadmin_password
PG_SSL_CA_CERT_PATH=

# Connection Pool Settings
PG_POOL_MAX=20
PG_POOL_IDLE_TIMEOUT=30000

# Redis Configuration (REQUIRED)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Third-Party Integrations
GEMINI_API_KEY=your_gemini_key
AWS_SES_KEY=your_aws_ses_key
